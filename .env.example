# OpenAI-compatible LLM endpoint (any provider works — NVIDIA NIM, Google AI Studio, OpenAI, ...)
NVIDIA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# API key for the endpoint above. NEVER commit this file with a real key.
NVIDIA_API_KEY=<your-api-key-here>
# Model id for the endpoint above
MODEL=gemini-2.5-flash
